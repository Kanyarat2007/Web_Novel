@model BookshelfViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "ชั้นหนังสือของฉัน";
    var tab = ViewBag.Tab as string ?? "writer";
}

<div class="container-xxl" style="max-width:950px;">

    <h2 class="mt-3">ชั้นหนังสือของฉัน</h4>

        @* ── Tabs ── *@
        <ul class="nav nav-underline-custom mb-4">
            <li class="nav-item">
                <a class="nav-link @(tab == "shelf" ? "active" : "")" asp-action="Index" asp-route-tab="shelf">
                    นิยายที่เพิ่มไว้
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(tab == "bookmark" ? "active" : "")" asp-action="Index" asp-route-tab="bookmark">
                    บุ๊คมาร์ค
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(tab == "recent" ? "active" : "")" asp-action="Index" asp-route-tab="recent">
                    อ่านล่าสุด
                </a>
            </li>
        </ul>

        @* ── Tab: shelf ── *@
        @if (tab == "shelf")
        {
            @if (!Model.Novels.Any())
            {
                <p class="text-body-secondary">ยังไม่มีนิยายในชั้นหนังสือ</p>
            }
            else
            {
                <div class="card-soft">
                    <partial name="_NovelRow" model="Model.Novels" />
                </div>
            }
        }

        @* ── Tab: bookmark ── *@
        @if (tab == "bookmark")
        {
            @if (!Model.Bookmarks.Any())
            {
                <p class="text-body-secondary">ยังไม่มีบุ๊คมาร์ค</p>
            }
            else
            {
                <div class="card-soft">
                    <div class="d-flex gap-2 overflow-auto pb-3">
                        @foreach (var bm in Model.Bookmarks)
                        {
                            <a asp-area="Reader" asp-controller="Novel" asp-action="NovelChapter"
                                   asp-route-novelId="@bm.Chapter.NovelId" asp-route-chapterNumber="@bm.Chapter.ChapterNumber"
                                   class="text-decoration-none flex-shrink-0">
               
                                <div class="ps-2" style="width:130px;">

                                    @* รูป *@
                                    <img src="@(bm.Chapter.Novel?.CoverImageUrl ?? "https://picsum.photos/seed/" + bm.Chapter.NovelId + "/100/140")"
                                         class="rounded-2" style="width:110px; height:140px; object-fit:cover;"
                                         alt="@bm.Chapter.Novel?.Title" />

                                    @* ข้อมูล *@
                                    <p class="text-body small mt-1 mb-0"
                                           style="overflow:hidden; white-space:nowrap; text-overflow:ellipsis;">
                                        @bm.Chapter.Novel?.Title
                                    </p>
                                    
                                    <p class="text-body-secondary mb-0" style="font-size:11px;">
                                        @bm.Chapter.Title
                                    </p>
                                    @* <p class="text-body-secondary mb-0" style="font-size:11px;">
                                    <i class="bi bi-eye"></i> @novel.TotalViews
                                    <i class="bi bi-heart"></i> @novel.TotalViews
                                    <i class="bi bi-list-ul"></i> ตอน
                                </p> *@
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        }

        @* ── Tab: recent ── *@
        @if (tab == "recent")
        {
            @if (!Model.RecentNovels.Any())
            {
                <p class="text-body-secondary">ยังไม่มีประวัติการอ่าน</p>
            }
            else
            {
                <div class="card-soft">
                    <partial name="_RecentNovelRow" model="Model.RecentNovels" />
                </div>
            }
        }
    </div>