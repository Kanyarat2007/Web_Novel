@* บน *@
<div class="fixed-top bg-body border-top border-bottom py-2" style="top:89px; z-index:1020;">

    <div class="container" style="max-width:950px;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

            @* ซ้าย *@
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <a asp-action="NovelDetail" asp-route-id="@Model.NovelId"
                       class="btn btn-sm btn-outline-primary rounded-pill">
                    <i class="bi bi-book"></i>
                    นิยาย
                </a>

                <!-- สารบัญ -->
                <button class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="offcanvas"
                        data-bs-target="#tocPanel">
                    <i class="bi bi-list-ul"></i>
                    <span class="d-none d-sm-inline">สารบัญ</span>
                </button>

                <div class="text-body-secondary small text-truncate" style="max-width:200px;">
                    @Model.ChapterTitle
                </div>
            </div>

            @* ขวา *@
            <div class="d-flex align-items-center gap-2 flex-wrap">

                @* เมนูควบคุม *@
                <div class="reader-controls d-flex align-items-center gap-2">
                    <button id="font-decrease" class="btn btn-sm btn-outline-primary rounded-pill">A-</button>
                    <button id="font-increase" class="btn btn-sm btn-outline-primary rounded-pill">A+</button>

                    <select id="font-family" class="form-select form-select-sm w-auto rounded-pill">
                        <option value="sarabun">Sarabun</option>
                        <option value="prompt">Prompt</option>
                    </select>
                </div>
                
                @* โน๊ต *@
                <button class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="offcanvas"
                        data-bs-target="#notePanel">
                    <i class="bi bi-pencil-square"></i>
                    <span class="d-none d-sm-inline">โน๊ต</span>
                </button>
                
                @* บุ๊คมาร์ค *@
                <button class="btn btn-sm @(Model.IsBookmarked ? "btn-primary" : "btn-outline-primary") rounded-pill"
                        id="bookmarkBtn" onclick="toggleBookmark()">

                    @if (Model.IsBookmarked)
                    {
                        <i class="bi bi-bookmark-check-fill"></i>
                        <span class="ms-1">บันทึกแล้ว</span>
                    }
                    else
                    {
                        <i class="bi bi-bookmark"></i>
                        <span class="ms-1">เพิ่มบุ๊คมาร์ค</span>
                    }

                </button>
            </div>

            @* สารบัญ *@
            <div class="offcanvas offcanvas-start px-3 pt-3" tabindex="-1" id="tocPanel">
                <div class="offcanvas-header mt-3">
                    <h5>สารบัญ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                </div>

                <div class="offcanvas-body">
                    @foreach (var ch in Model.Chapters)
                    {
                        <a asp-action="NovelChapter" asp-route-novelId="@Model.NovelId"
                               asp-route-chapterNumber="@ch.ChapterNumber"
                               class="d-block mb-2 text-decoration-none @(ch.ChapterNumber == Model.ChapterNumber ? "fw-bold text-primary" : "")">
                            @ch.Title
                        </a>
                    }
                </div>
            </div>

            @* เพ่ิมโน๊ต *@
            <div class="offcanvas offcanvas-end px-3 pt-3" tabindex="-1" id="notePanel">
                <div class="offcanvas-header mt-3">
                    <h5>โน๊ตของฉัน</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                </div>

                @if (Model.IsLoggedIn)
                {
                    <textarea id="noteText" class="form-control bg-body-secondary border-0" rows="3"
                              placeholder="เขียนโน๊ตส่วนตัว...">@Model.UserNote</textarea>

                    <button onclick="saveNote()" class="btn btn-primary btn-sm mt-2">
                        บันทึกโน๊ต
                    </button>
                }
                else
                {
                    <div class="text-center mt-3">
                        <a asp-area="" asp-controller="Account" asp-action="Login" class="text-primary">
                            ล็อกอินเพื่อเขียนโน๊ต
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* ล่าง *@
<div class="fixed-bottom bg-body border-top py-2" style="z-index:1000;">
    <div class="container" style="max-width:950px;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

            <!-- ซ้าย คอมเม้น -->
            <div>
                <a href="#commentSection" class="btn btn-sm btn-outline-primary rounded-pill">
                    <i class="bi bi-chat-dots"></i>
                    แสดงความคิดเห็น
                </a>
            </div>

            <!-- ขวา ปุ่ม -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (Model.PrevChapterNumber != null)
                {
                    <a asp-action="NovelChapter" asp-route-novelId="@Model.NovelId"
                           asp-route-chapterNumber="@Model.PrevChapterNumber" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i>
                        ตอนก่อนหน้า
                    </a>
                }

                @if (Model.NextChapterNumber != null)
                {
                    <a asp-action="NovelChapter" asp-route-novelId="@Model.NovelId"
                           asp-route-chapterNumber="@Model.NextChapterNumber" class="btn btn-primary btn-sm">
                        ตอนถัดไป
                        <i class="bi bi-arrow-right"></i>
                    </a>
                }
            </div>

        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/reader.css" />
<script src="~/js/reader.js"></script>

<script>
    function toggleBookmark() {
        if (!@Model.IsLoggedIn.ToString().ToLower()) {
            alert("กรุณาเข้าสู่ระบบก่อน");
            return;
        }

        const formData = new FormData();
        formData.append("chapterId", @Model.ChapterId);

        fetch('/Reader/Novel/ChapterBookmark', {
            method: 'POST',
            body: formData
        })
            .then(res => {
                if (res.status === 401) {
                    alert("กรุณาเข้าสู่ระบบก่อน");
                    return;
                }
                return res.json();
            })
            .then(data => {
                if (!data) return;

                const btn = document.getElementById("bookmarkBtn");

                if (data.bookmarked) {
                    btn.innerHTML = `
                <i class="bi bi-bookmark-check-fill"></i>
                <span class="ms-1">บันทึกแล้ว</span>
            `;
                    btn.classList.remove("btn-outline-primary");
                    btn.classList.add("btn-primary");
                } else {
                    btn.innerHTML = `
                <i class="bi bi-bookmark"></i>
                <span class="ms-1">เพิ่มบุ๊คมาร์ค</span>
            `;
                    btn.classList.remove("btn-primary");
                    btn.classList.add("btn-outline-primary");
                }
            });
    }
</script>

<script>
    function saveNote() {
        if (!@Model.IsLoggedIn.ToString().ToLower()) {
            alert("กรุณาเข้าสู่ระบบก่อน");
            return;
        }

        const formData = new FormData();
        formData.append("chapterId", @Model.ChapterId);
        formData.append("content", document.getElementById("noteText").value);

        fetch('/Reader/Novel/SaveNote', {
            method: 'POST',
            body: formData
        })
            .then(res => {
                if (res.status === 401) {
                    alert("กรุณาเข้าสู่ระบบก่อน");
                    return;
                }
                return res.json();
            })
            .then(data => {
                if (data) alert("บันทึกแล้ว");
            });
    }
</script>