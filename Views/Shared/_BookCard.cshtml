@model Web_Novel.Models.Novel

<div class="card me-3" style="width: 150px; flex: 0 0 auto;">
    <img src="@Model.CoverImageUrl" class="card-img-top" alt="@Model.Title" style="height:200px; object-fit:cover;">
    <div class="card-body p-2">
        <h6 class="card-title text-truncate" title="@Model.Title">@Model.Title</h6>
    </div>
</div>