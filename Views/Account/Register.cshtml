@{
    Layout = null;
}
@model Web_Novel.ViewModels.RegisterViewModel

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<body class="bg-secondary-subtle">

    <div class="d-flex justify-content-center align-items-center vh-100">

        <div class="bg-white p-4 rounded shadow" style="width:350px">
            <i class="bi bi-book fs-1 mb-2 text-center d-block"></i>

            <h4 class="text-center mb-2">สมัครสมาชิก</h4>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <div asp-validation-summary="All" class="text-danger"></div>

            <form asp-controller="Account" asp-action="Register" class="text-start" method="post">
                <label asp-for="Username"></label>
                <input asp-for="Username" class="form-control mb-2" />

                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" class="form-control mb-2" />

                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" class="form-control mb-2" />

                <label asp-for="BirthDate"></label>
                <input asp-for="BirthDate" type="date" class="form-control mb-2" />

                <button class="btn btn-success w-100">สมัครสมาชิก</button>
            </form>

            <div class="d-flex">
                <p class="px-2 text-secondary">หากมีบัญชีแล้ว โปรด</p>
                <a asp-area="" asp-controller="Account" asp-action="Login">เข้าสู่ระบบ</a>
            </div>
        </div>
    </div>

</body>