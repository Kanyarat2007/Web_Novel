@model GenrePageViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.GenreName;
}

<div class="container-xxl" style="max-width:950px;">

    <h2>
        หมวดหมู่ @Model.GenreName
    </h2>

    <div class="card-soft my-4">
        
        @if (!Model.Novels.Any())
        {
            <div class="text-body-secondary">
                ยังไม่มีนิยายในหมวดนี้
            </div>
        }
        else
        {
            <partial name="_NovelRow" model="Model.Novels" />
        }
    </div>

    @* ── Pagination ── *@
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4 gap-2">

            @if (Model.CurrentPage > 1)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-action="ByGenre" asp-route-genreId="@Model.GenreId"
                       asp-route-page="@(Model.CurrentPage - 1)">
                    ← ก่อนหน้า
                </a>
            }

            <span class="align-self-center small text-body-secondary">
                หน้า @Model.CurrentPage / @Model.TotalPages
            </span>

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-action="ByGenre" asp-route-genreId="@Model.GenreId"
                       asp-route-page="@(Model.CurrentPage + 1)">
                    ถัดไป →
                </a>
            }

        </div>
    }

</div>