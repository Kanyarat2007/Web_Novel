@inject IHttpContextAccessor HttpContextAccessor
@model ChapterViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "แก้ไขตอน";
}

<div class="container mt-4" style="max-width:950px;">
    <input type="hidden" asp-for="ChapterId" />
    
    <h2>
        @(Model.ChapterId == 0 ? "เพิ่มตอนใหม่" : "แก้ไขตอน")
    </h2>

    @* <h2>ตอนนิยาย</h2> *@

    <form asp-action="Save" method="post">
        <input type="hidden" asp-for="ChapterId" />
        <input type="hidden" asp-for="NovelId" />

        @* <div class="mb-3">
            <label>ตอนที่</label>
            <input asp-for="ChapterNumber" class="form-control" readonly />
        </div> *@

        <div class="card-soft mb-3">
            <div class="mb-3">
                <label>ชื่อตอนนิยาย</label>
                <input asp-for="Title" class="form-control" />
            </div>

            <div class="mb-3">
                <label>เนื้อหาภายในตอน</label>
                <textarea id="summernote" name="Content" class="form-control">
                    @Model.Content
                </textarea>
                @* <div id="editor" style="height:300px;"></div>

                <input type="hidden" name="Content" id="hiddenContent" />

                <script id="initialContent" type="application/json">
                    @Html.Raw(Json.Serialize(Model.Content ?? ""))
                </script> *@
                
            </div>
        </div>

        @* คำเตือน *@
        <div class="card-soft mb-3">
            <label class="form-label">คำเตือนเนื้อหา (Trigger Warning)</label>

            <div class="row">
                @foreach (var w in Model.AllWarnings)
                {
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedWarningIds" value="@w.WarningId"
                            @(Model.SelectedWarningIds.Contains(w.WarningId) ? "checked" : "") />

                            <label class="text-basic form-check-label fw-bold">
                                @w.Name
                            </label>

                            <div class="text-muted small text-truncate" title="@w.Description">
                                @w.Description
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card-soft mb-3">

            <div class="mb-3">
                <label>สถานะ</label>
                <select asp-for="PublishStatus" class="form-select">
                    <option value="draft">Draft</option>
                    <option value="published">Published</option>
                </select>
            </div>

            <div class="mb-3 form-check">
                <input type="checkbox" asp-for="IsCoinRequired" class="form-check-input" id="isCoin" />
                <label class="form-check-label" for="isCoin">ติดเหรียญตอนนี้หรือไม่</label>
            </div>

            <div class="mb-3">
                <label>ราคาเหรียญ</label>
                <input asp-for="CoinPrice" class="form-control" />
            </div>
        </div>

        @* <ul id="chapterList">
            @foreach (var c in Model)
            {
                <li data-id="@c.ChapterId">
                    ตอนที่ @c.ChapterNumber - @c.Title
                </li>
            }
        </ul> *@
        
        <div class="text-end">
            <button type="submit" class="btn btn-primary">บันทึก</button>
        </div>
    </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>


@* <link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script> *@

<script>
    document.addEventListener("DOMContentLoaded", function () {

    // ===== Toggle ราคา =====
    const checkbox = document.getElementById('isCoin');
    const priceInput = document.querySelector('[name="CoinPrice"]');

    function togglePrice() {
    if (!checkbox || !priceInput) return;

    priceInput.disabled = !checkbox.checked;
    if (!checkbox.checked) priceInput.value = 0;
    }

    if (checkbox && priceInput) {
    checkbox.addEventListener('change', togglePrice);
    togglePrice();
    }

    // ===== Quill =====
    @* const editorEl = document.getElementById('editor');
    if (!editorEl) return;

    var quill = new Quill('#editor', {
    theme: 'snow',
    modules: {
    toolbar: [
    ['bold', 'italic', 'underline'],
    [{ 'align': [] }],
    [{ 'header': [1, 2, false] }],
    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
    ['link']
    ]
    }
    }); *@

    $(document).ready(function () {
    $('#summernote').summernote({
    height: 500,
    placeholder: 'เริ่มเขียนเนื้อหาที่นี่...',
    toolbar: [
    ['style', ['style']],
    ['font', ['bold', 'underline', 'clear']],
    ['para', ['ul', 'ol', 'paragraph']],
    ['insert', ['link', 'picture']],
    ['view', ['fullscreen']]
    ]
    });
    });

    function toggleMode(type, btn) {
    $('.type-btn').removeClass('active');
    $(btn).addClass('active');

    $('.section').removeClass('active');
    $('#' + type + '-editor').addClass('active');

    $('#selectedType').val(type);
    }

    // ===== โหลด content =====
    const contentEl = document.getElementById("initialContent");
    let initialContent = "";

    if (contentEl) {
    initialContent = JSON.parse(contentEl.textContent);
    }

    if (initialContent) {
    quill.root.innerHTML = initialContent;
    }

    // ===== Submit =====
    @* const form = document.querySelector("form");
    if (form) {
    form.onsubmit = function () {
    document.getElementById("hiddenContent").value = quill.root.innerHTML;
    };
    } *@

    });
</script>