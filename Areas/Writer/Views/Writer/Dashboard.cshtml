@* views/Writer/Dashboard.cshtml *@
@model WriterDashboardViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "โหมดนักเขียน";
}

<div class="container-xxl" style="max-width:950px;">
    <h1 class="mt-3">นักเขียน</h1>

    @* ── Tabs ── *@
    <ul class="nav nav-underline-custom mb-4">

        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "novels" ? "active" : "")" asp-area="Writer" asp-controller="Writer"
                   asp-action="Dashboard" asp-route-tab="novels">
                งานเขียนของฉัน
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "pennames" ? "active" : "")" asp-area="Writer"
                   asp-controller="Writer" asp-action="Dashboard" asp-route-tab="pennames">
                นามปากกา
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "stats" ? "active" : "")" asp-area="Writer" asp-controller="Writer"
                   asp-action="Dashboard" asp-route-tab="stats">
                สถิติงานเขียน
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "payments" ? "active" : "")" asp-area="Writer"
                   asp-controller="Writer" asp-action="Dashboard" asp-route-tab="payments">
                การชำระเงิน
            </a>
        </li>
    </ul>

    @if (Model.ActiveTab == "novels")
    {
        <partial name="_MyNovels" model="Model.Novels" />
    }

    @if (Model.ActiveTab == "pennames")
    {
        <partial name="_PenNames" model="Model.PenNames" />
    }
        
    @if (Model.ActiveTab == "stats")
    {
        <h3>สถิติผลงาน</h3>
        <div class="card-soft">

        

            <table class="table table-hover">
                <thead class="">
                    <tr>
                        <th>ชื่อนิยาย</th>
                        @* <th>ประเภท</th> *@
                        <th>ยอดเข้าอ่าน</th>
                        <th>ยอดกดถูกใจ</th>
                        <th>ยอดเพิ่มเข้าชั้นหนังสือ</th>
                        @* <th>เหรียญ</th> *@
                        @* <th>อัปเดต</th> *@
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Stats)
                    {
                        <tr>
                            <td>
                                @(item.ContentType == "Novel"
                                    ? item.NovelTitle
                                    : item.MangaTitle)
                            </td>
                            @* <td>@item.ContentType</td> *@
                            <td>@item.TotalViews</td>
                            <td>@item.TotalLikes</td>
                            <td>@item.TotalBookshelf</td>
                            @* <td>@item.TotalCoinEarned</td> *@
                            @* <td>@(item.UpdatedAt.HasValue? item.UpdatedAt.Value.ToString("dd/MM/yyyy") : "")</td> *@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.ActiveTab == "payments")
    {
        <partial name="_Payment" model="Model" />
    }

</div>