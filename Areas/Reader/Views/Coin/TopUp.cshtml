@using Web_Novel.ViewModels
@using Web_Novel.Helpers
@model TopUpViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "เหรียญของฉัน";
}

<div class="container-xxl" style="max-width:950px;">

    <div class="d-flex justify-content-between align-items-center mb-3 mt-3">
        <h2 class="mt-3">เติมเหรียญ</h2>

        <div>
            <h2><i class="bi bi-coin"></i>
                <span>@Model.CurrentBalance</span>
            </h2>
        </div>
    </div>

    <div class="row">
        @foreach (var package in Model.Packages)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">

                        <h5 class="card-title">@package.Name</h5>

                        @* <h3 class="text-warning">
                            @(package.CoinAmount + package.BonusCoin)
                        </h3> *@

                        @* <p class="text-muted mb-1">
                            + โบนัส @package.BonusCoin
                        </p>

                        <p class="fw-bold">
                            @package.Price บาท
                        </p> *@

                        <div class="mb-2">

                            <h4 class="text-warning mb-1">
                                @(package.CoinAmount + package.BonusCoin)
                                <i class="bi bi-coin"></i>
                                @* <small class="text-muted fs-6">เหรียญ </small> *@
                            </h4>

                            @if (package.BonusCoin > 0)
                            {
                                <p class="text-success mb-0">
                                    + โบนัส @package.BonusCoin <i class="bi bi-coin"></i>
                                </p>
                            }

                        </div>

                        <p>
                            ราคา:
                            @if (package.DiscountApplied > 0)
                            {
                                <del>@package.Price</del>
                                <span class="text-danger">@package.FinalPrice</span>
                            }
                            else
                            {
                                @package.Price
                            }
                        </p>

                        <form asp-action="Purchase" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="packageId" value="@package.PackageId" />

                            <button type="submit" class="btn btn-primary w-100 d-flex justify-content-center"
                                    onclick="return confirm('ยืนยันการซื้อแพ็คนี้?')">
                                ซื้อแพ็ค
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

</div>