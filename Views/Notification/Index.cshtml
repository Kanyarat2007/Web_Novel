@model List<Web_Novel.ViewModels.NotificationViewModel>

<div class="container-xxl" style="max-width:950px;">

    <div>
        <h2 class="my-3">แจ้งเตือน</h2>
    </div>

    <div>
        @foreach (var n in Model)
        {
            <a asp-action="MarkAsRead" asp-route-id="@n.NotificationId" class="d-block text-decoration-none mb-2">

                <div class="card-soft p-3 rounded-4 border @(n.IsRead ? "" : "fw-bold")">

                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="fw-semibold">@n.NovelTitle</div>
                            <div>@n.Message</div>
                        </div>

                        <div class="text-muted small text-end">
                            @n.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                </div>
            </a>
        }

    </div>
</div>