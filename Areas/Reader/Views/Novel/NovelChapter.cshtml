@model NovelChapterViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = $"{Model.NovelTitle}";
}

<partial name="_ChapterNavbar" model="Model" />

<div class="container" style="max-width:950px;">
    
    <div class="mt-5" style="height:50px;"></div>

    @if (Model.CanRead)
    {
        @* อ่านได้เลย *@
        <div id="novel-content" class="card-soft">
            <p class="text-basic">
                @Html.Raw(Model.Content)
            </p>
        </div>
    }
    else
    {
        @* ติดเหรียญ *@
        <div class="text-center card-soft" style="height:400px">

            @if (!Model.IsLoggedIn)
            {
                <p>กรุณาเข้าสู่ระบบก่อน</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                    เข้าสู่ระบบ
                </a>
            }
            else
            {
                <h4 class="text-danger">ซื้อเพื่ออ่าน</h4>

                <form asp-controller="Coin" asp-action="BuyChapter" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="chapterId" value="@Model.ChapterId" />
                    <input type="hidden" name="novelId" value="@Model.NovelId" />

                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-coin"></i> @Model.CoinPrice เหรียญ
                    </button>
                </form>
            }

        </div>
    }

    @* คอมเม้น *@
    <div id="commentSection" class="card-soft mt-3">
        <h6 class="mb-0">
            แสดงความคิดเห็นของคุณ
        </h6>
    
        @* กรอกคอมเม้น *@
        @if (Model.IsLoggedIn)
        {
            <form asp-area="Reader" asp-controller="Comment" asp-action="AddComment" method="post" class="mt-3 text-end">
                <input type="hidden" name="novelId" value="@Model.NovelId" />
                <input type="hidden" name="ChapterId" value="@Model.ChapterId" />
                <textarea name="content" class="form-control" placeholder="แสดงความคิดเห็น..." rows="3"></textarea>
                <button class="btn btn-primary btn-sm mt-2">ส่งความคิดเห็น</button>
            </form>
        }
        else
        {
            <div class="text-center mt-3">
                <a asp-area="" asp-controller="Account" asp-action="Login">
                    ล็อกอินเพื่อแสดงความคิดเห็น
                </a>
            </div>
        }
    </div>
    
    @* แสดงคอมเม้นทั้งหมด *@
    <div class="card-soft mt-3">
        <div class="d-flex justify-content-between align-items-center ">

            <h6 class="mb-0">
                ความคิดเห็นทั้งหมด (@Model.Comments.Count)
            </h6>

            <div>
                <a asp-route-novelId="@Model.NovelId" asp-route-chapterNumber="@Model.ChapterNumber"
                       asp-route-sort="new"
                       class="btn btn-sm @(Model.Sort == "new" ? "btn-primary" : "btn-outline-secondary")">
                    ใหม่
                </a>

                <a asp-route-novelId="@Model.NovelId" asp-route-chapterNumber="@Model.ChapterNumber"
                       asp-route-sort="old"
                       class="btn btn-sm @(Model.Sort == "old" ? "btn-primary" : "btn-outline-secondary")">
                    เก่า
                </a>
            </div>
        </div>

        @if (!Model.Comments.Any())
        {
            <p class="text-body-secondary small mt-2">ยังไม่มีความคิดเห็น</p>
        }
        else
        {
            <div class="d-flex flex-column justify-content-between gap-2 mt-3">
                @foreach (var c in Model.Comments)
                {
                    <div class="card-soft comment-card">

                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                @if (c.UserId == Model.CurrentUserId)
                                {
                                    <span class="badge bg-primary ms-1"> @c.UserName</span>
                                }
                                else
                                {
                                    <a asp-area="Reader" asp-controller="Profile" asp-action="ViewProfile" asp-route-id="@c.UserId"
                                           class="fw-semibold text-decoration-none">
                                        @c.UserName
                                    </a>
                                }
                            </div>

                            @* Action *@
                            <div class="d-flex align-items-center gap-2">
                            
                                <div class="small text-body-secondary ">
                                    @TimeHelper.ToThaiString(c.CreatedAt)
                                </div>
                                
                                @* ลบของตัวเอง *@
                                @if (c.UserId == Model.CurrentUserId)
                                {
                                    <form asp-area="Reader" asp-controller="Comment" asp-action="DeleteComment" method="post">
                                        <input type="hidden" name="commentId" value="@c.CommentId" />
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash3"></i></button>
                                    </form>
                                }
                                else if (Model.IsLoggedIn)
                                {
                                    <button class="btn btn-sm btn-light rounded-circle" data-bs-toggle="modal"
                                            data-bs-target="#reportModal" data-comment-id="@c.CommentId">
                                        <i class="bi bi-flag"></i>
                                    </button>
                                }
                                
                            </div>

                        </div>

                        @* content *@
                        <div class="mt-2">

                            @* ลบโดยแอดมิน *@
                            @if (c.Status == "deleted" || c.IsDeleted)
                            {
                                <div class="text-muted fst-italic">
                                    คอมเมนต์นี้ถูกลบโดยผู้ดูแล
                                </div>
                            }
                            @* สปอย *@
                            else if (c.IsSpoiler)
                            {
                                <div class="spoiler-box blur"
                                     onclick="this.classList.remove('blur'); this.querySelector('.warning').style.display='none';">
                                    <div class="warning">คลิกเพื่อดูสปอย</div>
                                    <div class="content text-body">
                                        @c.Content
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-body">@c.Content</div>
                            }
                        </div>

                    </div>
                }
            </div>
        }
    </div>
</div>

<link rel="stylesheet" href="~/css/reader.css" />
<script src="~/js/reader.js"></script>