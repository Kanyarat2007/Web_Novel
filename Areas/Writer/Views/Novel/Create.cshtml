@inject IHttpContextAccessor HttpContextAccessor
@model CreateNovelViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "สร้างนิยายเรื่องใหม่";
}

<div class="container mt-4" style="max-width:950px;">

    @Html.AntiForgeryToken()
                
    <div asp-validation-summary="All" class="text-danger"></div>

    <h2>@(Model.IsEdit ? "แก้ไขนิยาย" : "สร้างนิยายเรื่องใหม่")</h2>

    @if (Model.PenNames == null || !Model.PenNames.Any())
    {
        <div class="alert alert-warning">
            กรุณาสร้างนามปากกาก่อนที่จะสร้างนิยาย
        </div>
    }
    else
    {
        <form asp-action="Save" method="post" enctype="multipart/form-data">
            @* <input type="hidden" name="id" value="@Model.NovelId" /> *@
            <input type="hidden" asp-for="NovelId" />

            @* สถานะ *@
            <div class="card-soft mb-3">
                <div class="mb-3">
                    <label for="PublishStatus" class="form-label">สถานะการเผยแพร่</label>
                    <select asp-for="PublishStatus" class="form-select">
                        <option value="draft">แบบร่าง</option>
                        @* <option value="ongoing">Ongoing</option> *@
                        <option value="published">เผยแพร่</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="Status" class="form-label">สถานะนิยาย</label>
                    <select asp-for="Status" name="Status" class="form-select">
                        <option value="ongoing">ยังไม่จบ</option>
                        <option value="completed">จบแล้ว</option>
                    </select>
                </div>
            </div>

            @* นามปากกา ประเภท หมวดหมู่ คำเตือน *@
            <div class="card-soft mb-3">
                @* นามปากกา *@
                <div class="mb-3">
                    <div class="mb-3">
                        <label for="penNameId" class="form-label">นามปากกา</label>
                        <select asp-for="PenNameId" class="form-select"
                                asp-items="@(new SelectList(Model.PenNames, "PenNameId", "PenName"))">
                            @if (Model.PenNames == null || !Model.PenNames.Any())
                            {
                                <option value="">กรุณาสร้างนามปากกาก่อน</option>
                            }
                            else
                            {
                                <option value="">กรุณาเลือกนามปากกา</option>
                            }
                        </select>
                    </div>
                </div>

                @* ประเภทนิยาย *@
                <div class="mb-3">
                    <label for="penNameId" class="form-label">ประเภทนิยาย</label>
                    <select asp-for="SeriesType" class="form-select">
                        <option value="short">เรื่องสั้น</option>
                        <option value="series">เรื่องยาวหลายตอน</option>
                    </select>
                </div>

                @* หมวดหมู่ *@
                <div class="mb-3">
                    <label for="genreId" class="form-label">หมวดหมู่</label>
                    <select asp-for="GenreId" class="form-select"
                            asp-items="@(new SelectList(Model.Genres, "GenreId", "Name"))">
                        <option value="">-- เลือกหมวดหมู่ --</option>
                    </select>
                <span asp-validation-for="GenreId" class="text-danger"></span>
                </div>

                @* คำเตือน *@
                <label class="form-label fw-semibold">คำเตือนเนื้อหา</label>

                <!-- checkbox -->
                <div class="row">
                    @foreach (var tw in Model.TriggerWarnings)
                    {
                        <div class="col-md-4">
                            <div class="form-check">

                                <input class="form-check-input"
                                    type="checkbox"
                                    name="SelectedWarningIds"
                                    value="@tw.WarningId"
                                    id="tw_@tw.WarningId"
                                    @(Model.SelectedWarningIds.Contains(tw.WarningId) ? "checked" : "") />

                                <label class="form-check-label w-100" for="tw_@tw.WarningId">
                                    <div class="fw-semibold">@tw.Name</div>
                                    <div class="small text-muted">@tw.Description</div>
                                </label>

                            </div>
                        </div>
                    }
                </div>

            </div>

            @* รูป ชื่อเรื่อง เรื่องย่อ *@
            <div class="card-soft mb-3">
                <div class="row g-3 align-items-start">
                    @* รูป *@
                    <div class="col-md-4 text-center">
                        <img id="previewImage"
                            src="@(string.IsNullOrEmpty(Model.ExistingCoverImageUrl) 
                                    ? "/images/default-novel.png" 
                                    : Model.ExistingCoverImageUrl)"
                            class="rounded-3 shadow-sm mb-3"
                            style="width:110px; height:140px; object-fit:cover;"
                            onerror="this.src='/images/default-novel.png'" />
                            
                        <input type="file" name="CoverImage" class="form-control" onchange="previewFile(event)" />

                        <button type="button" class="btn btn-danger btn-sm mt-2" onclick="removeImage()">
                            ลบรูป
                        </button>
                    </div>

                    @* ชื่อเรื่อง เรื่องย่อ *@
                    <div class="col-md-8">
                        @* ชื่อเรื่อง *@
                        <div class="mb-3">
                            <label for="title" class="form-label">ชื่อเรื่อง</label>
                            <input asp-for="Title" class="form-control" />
                        </div>

                        @* เรื่องย่อ *@
                        <div class="mb-3">
                            <label for="synopsis" class="form-label">เรื่องย่อ</label>
                            <textarea asp-for="Synopsis" class="form-control" rows="5">@Model.Synopsis</textarea>
                            
                        </div>
                    </div>
                </div>
            </div>
            
            @* ข้อมูลเกี่ยวกับนิยาย *@
            <div class="card-soft mb-3">
                <label for="authorNote" class="form-label">ข้อมูลเกี่ยวกับนิยาย</label>
                <textarea id="summernote" asp-for="AuthorNote" class="form-control" rows="10">@Model.AuthorNote</textarea>
            </div>

            @* ปุ่มสร้างนิยาย แก้ไข *@
            <div class="text-end">
                <button type="submit" class="btn btn-primary">
                    @(Model.IsEdit ? "บันทึกการแก้ไข" : "สร้างนิยาย")
                </button>

                @* ลบ *@
                @if (Model.IsEdit)
                {
                    <button type="button"
                            class="btn btn-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal">
                        ลบนิยาย
                    </button>
                }  
            </div>
            
            @* Modal เลือกคำเตือน *@
            <div class="modal fade" id="editTWModal" tabindex="-1">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header border-0">
                            <h5 class="modal-title">เลือกคำเตือนเนื้อหา</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="d-flex flex-column gap-2">
                                @foreach (var tw in Model.TriggerWarnings)
                                    {
                                        var isChecked = Model.TriggerWarningIds != null && Model.TriggerWarningIds.Contains(tw.WarningId);

                                        <div class="form-check">
                                            <input type="checkbox"
                                                id="tw_@tw.WarningId"
                                                name="TriggerWarningIds"
                                                value="@tw.WarningId"
                                                class="form-check-input trigger-checkbox"
                                                @(isChecked ? "checked" : "") />

                                            <label class="form-check-label text-dark" for="tw_@tw.WarningId">
                                                @tw.Name - @tw.Description
                                            </label>
                                        </div>
                                    }
                            </div>
                        </div>
                        <div class="modal-footer border-0">
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    data-bs-dismiss="modal">ยกเลิก</button>
                            <button type="button" class="btn btn-primary btn-sm" id="saveTWBtn">บันทึก</button>
                        </div>
                    </div>
                </div>
            </div>

        </form>
    }

            @* Modal ลบ *@
            <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title text-danger">ยืนยันการลบนิยาย</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">
                            คุณแน่ใจหรือไม่ว่าต้องการลบนิยายเรื่องนี้?
                            <br />
                            <span class="text-muted">การกระทำนี้ไม่สามารถย้อนกลับได้</span>
                        </div>

                        <div class="modal-footer">

                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                ยกเลิก
                            </button>

                            <form asp-action="Delete" method="post">
                                <input type="hidden" name="id" value="@Model.NovelId" />
                                <button type="submit" class="btn btn-danger">
                                    ลบ
                                </button>
                            </form>

                        </div>

                    </div>
                </div>
            </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>

<script>
    function previewFile(event) {
        const reader = new FileReader();
        reader.onload = function () {
            document.getElementById('previewImage').src = reader.result;
        }
        reader.readAsDataURL(event.target.files[0]);
    }

    function removeImage() {
        document.getElementById('previewImage').src = '/images/default-avatar.png';
    }
</script>

<script>
$(document).ready(function () {

    // ===== Summernote =====
    $('#summernote').summernote({
        height: 500,
        placeholder: 'เริ่มเขียนที่นี่...',
        callbacks: {
            onChange: function(contents) {
                $('textarea[name="AuthorNote"]').val(contents);
            }
        }
    });

    // ===== Warnings =====
    const selectedContainer = document.getElementById('selectedWarningsContainer');
    const checkboxes = document.querySelectorAll('.trigger-checkbox');

    function renderWarnings() {
        if (!selectedContainer) return;

        selectedContainer.innerHTML = '';

        checkboxes.forEach(cb => {
            if (cb.checked) {
                const label = document.querySelector(`label[for="${cb.id}"]`);
                const text = label.innerText.trim();
                const parts = text.split('|');

                const name = parts[0] ?? "";
                const desc = parts[1] ?? "";

                const div = document.createElement('div');
                div.className = 'warning-item';

                div.innerHTML = `
                    <div class="warning-title">${name}</div>
                    <div class="warning-desc">${desc}</div>
                `;

                selectedContainer.appendChild(div);
            }
        });

        if (selectedContainer.innerHTML === '') {
            selectedContainer.innerHTML = `<div class="text-body-secondary small">ยังไม่ได้เลือกคำเตือน</div>`;
        }
    }

    renderWarnings();

    const saveBtn = document.getElementById('saveTWBtn');
    if (saveBtn) {
        saveBtn.addEventListener('click', () => {
            renderWarnings();

            const modalEl = document.getElementById('editTWModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
            }
        });
    }

});
</script>