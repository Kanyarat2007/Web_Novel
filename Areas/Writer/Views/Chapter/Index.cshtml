@inject IHttpContextAccessor HttpContextAccessor
@model List<ChapterViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "แก้ไขตอน";
}

<div class="container mt-4" style="max-width:950px;">

    <div class="d-flex justify-content-between align-items-center">
        <h2>แก้ไขตอน</h2>
        <a asp-action="Create" asp-route-novelId="@ViewBag.NovelId" class="btn btn-primary mb-3"><i
            class="bi bi-plus-lg"></i>เพิ่มตอนนิยาย</a>
        </div>

        <div class="card-soft">
            <table class="table table-hover">
                <thead>
                    <tr>
                        @* <th>ตอนที่</th> *@
                        <th>ชื่อตอน</th>
                        <th>สถานะ</th>
                        <th>จัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            @* <td>@c.ChapterNumber</td> *@
                            <td>@c.Title</td>
                            <td>@c.PublishStatus</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@c.ChapterId" class="btn btn-sm btn-outline-primary"><i
                                    class="bi bi-pencil-square"></i>แก้ไข</a>
                                    <a asp-action="Delete" asp-route-id="@c.ChapterId" class="btn btn-sm btn-outline-danger"><i
                                        class="bi bi-trash3"></i> </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>