@* views/shared/_MyNovels.cshtml *@

@model List<MyNovelItemViewModel>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>งานเขียนของฉัน</h4>

    <div>
        <a asp-controller="Novel" asp-action="Create" class="btn btn-primary me-2">
            <i class="bi bi-plus-lg"></i>เพิ่มนิยาย
        </a>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card-soft">
        <p>ยังไม่มีผลงาน</p>
        <a asp-controller="Novel" asp-action="Create" class="btn btn-primary">
            เริ่มเขียนเรื่องแรก
        </a>
    </div>
}
else
{
    
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card-soft h-100 novel-card">

                    <!-- รูป -->
                    <img src="@(string.IsNullOrEmpty(item.CoverImageUrl)
                                                         ? Url.Content("~/images/default-novel.png")
                                                         : Url.Content(item.CoverImageUrl))" class="novel-img" />

                    <!-- เนื้อหา -->
                    <div class="p-3">

                        <h6 class="fw-semibold mb-1 text-truncate">
                            @item.Title
                        </h6>

                        <p class="text-muted small mb-1">
                            <i class="bi bi-pen"></i> @item.PenName
                        </p>

                        <!-- ตอน + วิว -->
                        <div class="d-flex justify-content-between small text-body-secondary mb-1">
                            <span><i class="bi bi-list-ul"></i> @item.TotalChapters ตอน</span>
                            <span><i class="bi bi-eye"></i> @item.TotalViews</span>
                        </div>

                        <small class="text-muted">
                            <i class="bi bi-calendar-week"></i> @item.UpdatedAt?.ToString("dd/MM/yyyy")
                        </small>
                    </div>

                    <!-- ปุ่ม -->
                    <div class="px-3 pb-3 d-flex gap-2">
                        <a asp-controller="Novel" asp-action="Edit" asp-route-id="@item.NovelId"
                               class="btn btn-sm btn-outline-primary flex-fill rounded-pill">
                            แก้ไข
                        </a>

                        <a asp-area="Writer" asp-controller="Chapter" asp-action="Index" asp-route-novelId="@item.NovelId"
                               class="btn btn-sm btn-light flex-fill rounded-pill">
                            ตอน
                        </a>
                    </div>

                </div>
            </div>
        }
    </div>
}