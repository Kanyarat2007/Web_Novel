@inject IHttpContextAccessor HttpContextAccessor
@model CreateNovelViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "แก้ไขนิยาย";
}

<div class="container mt-4" style="max-width:950px;">
    <p>แก้ไขนิยาย</p>

    @if (Model.PenNames == null || !Model.PenNames.Any())
    {
        <div class="alert alert-warning">
            กรุณาสร้างนามปากกาก่อนที่จะสร้างนิยาย
        </div>
    }
    else
    {
        <form asp-action="Create" asp-controller="Novel" method="post" enctype="multipart/form-data">

            @* นามปากกา *@
            <div class="mb-3">
                <label for="penNameId" class="form-label">เลือกนามปากกา</label>
                @* นามปากกา *@
                <div class="mb-3">
                    <label for="penNameId" class="form-label">เลือกนามปากกา</label>
                    <select class="form-select" id="penNameId" name="PenNameId" required @(Model.PenNames == null ||
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  !Model.PenNames.Any() ? "disabled" : "")>
                        @if (Model.PenNames == null || !Model.PenNames.Any())
                        {
                            <option value="">กรุณาสร้างนามปากกาก่อน</option>
                        }
                        else
                        {
                            <option value="">-- เลือกนามปากกา --</option>
                            foreach (var pen in Model.PenNames)
                            {
                                <option value="@pen.PenNameId" selected="@(pen.PenNameId == Model.PenNameId)">@pen.PenName</option>
                            }
                        }
                    </select>
                </div>
            </div>
        
            @* ประเภทนิยาย *@
            <div class="mb-3">
                <label for="penNameId" class="form-label">เลือกประเภทนิยาย</label>
                <select class="form-select" name="SeriesType" required>
                    @* <option value="">เลือกประเภทนิยาย</option> *@
                    @foreach (var option in new[] { "short", "series" })
                    {
                        <option value="@option">
                            @(option == "short" ? "เรื่องสั้น" : "เรื่องยาวหลายตอน")
                        </option>
                    }
                </select>
            </div>

            <!-- 🔹 รูป -->
            <div class="col-md-4 text-center">
                <img id="previewImage"
                     src="@(string.IsNullOrEmpty(Context.Session.GetString("AvatarUrl")) 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         ? "/images/default-avatar.png"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         : Context.Session.GetString("AvatarUrl"))"
                     class="rounded-circle border mb-3" style="width:120px;height:120px;object-fit:cover;" />

                <input type="file" name="CoverImage" class="form-control" onchange="previewFile(event)" />

                <button type="submit" name="removeCoverImage" value="true" class="btn btn-danger btn-sm mt-2">
                    ลบรูป
                </button>
            </div>
        
            <div class="mb-3">
                <label for="title" class="form-label">ชื่อเรื่อง</label>
                <input type="text" class="form-control" value="@Model.Title" id="title" name="Title" required />
            </div>

            <div class="mb-3">
                <label for="synopsis" class="form-label">เรื่องย่อ</label>
                <textarea class="form-control" id="synopsis" name="Synopsis" rows="4">@Model.Synopsis</textarea>
            </div>

            <div class="mb-3">
                <label for="authorNote" class="form-label">ข้อมูลเกี่ยวกับนิยาย</label>
                <textarea class="form-control" id="authorNote" name="AuthorNote" rows="3">@Model.AuthorNote</textarea>
            </div>

            <div class="mb-3">
                <label for="genreId" class="form-label">เลือกหมวดหมู่</label>
                <select class="form-select" id="genreId" name="GenreId" required>
                    @* <option value="">เลือกหมวดหมู่</option> *@
                    @if (Model.Genres != null)
                    {
                        foreach (var genre in Model.Genres)
                        {
                            <option value="@genre.GenreId" selected="@(genre.GenreId == Model.GenreId)">@genre.Name</option>
                        }
                    }
                </select>
            </div>

            <!-- ปุ่มเลือกคำเตือน -->
            <div class="card-soft mb-3">
                <label class="form-label fw-semibold">คำเตือนเนื้อหา</label>

                <!-- checkbox -->
                <div class="row">
                    @foreach (var tw in Model.TriggerWarnings)
                    {
                        <div class="col-md-4">
                            <div class="form-check">

                                <input class="form-check-input" type="checkbox" name="SelectedWarningIds" value="@tw.WarningId"
                                       id="tw_@tw.WarningId" @(Model.SelectedTriggerWarnings.Any(x => x.WarningId == tw.WarningId)
                                                                                                                      ? "checked" : "") />

                                <label class="form-check-label w-100" for="tw_@tw.WarningId">
                                    <div class="fw-semibold">@tw.Name</div>
                                    <div class="small text-muted">@tw.Description</div>
                                </label>

                            </div>
                        </div>
                    }
                </div>

                <button type="submit" class="btn btn-primary">บันทึก</button>
            </form>
        }
    </div>

    <!-- Modal เลือกคำเตือน -->
    <div class="modal fade" id="editTWModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title">เลือกคำเตือนเนื้อหา</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="d-flex flex-column gap-2">
                        @foreach (var tw in Model.TriggerWarnings)
                        {
                            <div class="form-check">
                                <input class="form-check-input trigger-checkbox" type="checkbox" value="@tw.WarningId"
                                       id="tw_@tw.WarningId" />
                                <label class="form-check-label" for="tw_@tw.WarningId">
                                    <strong>@tw.Name</strong><br />
                                    <small class="text-muted">@tw.Description</small>
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="button" class="btn btn-primary btn-sm" id="saveTWBtn">บันทึก</button>
                </div>
            </div>
        </div>
    </div>

