@model List<Web_Novel.Models.Readinghistory>

<div class="d-flex gap-2 overflow-auto pb-2">
    @foreach (var rh in Model)
    {
        <a asp-area="Reader" asp-controller="Novel" asp-action="NovelChapter" asp-route-novelId="@rh.NovelId"
               asp-route-chapterNumber="@rh.LastChapter?.ChapterNumber" class="text-decoration-none flex-shrink-0">

            <div class="ps-2" style="width:130px;">
                <img src="@(rh.Novel?.CoverImageUrl ?? "/images/default-novel.png")" class="rounded-2"
                     style="width:110px; height:140px; object-fit:cover;" />

                <p class="text-body small mt-1 mb-0 text-truncate">
                    @rh.Novel?.Title
                </p>
                
                <p class="text-body-secondary mb-0" style="font-size:11px;">
                    @rh.LastChapter?.Title
                </p>
            </div>
        </a>
    }
</div>