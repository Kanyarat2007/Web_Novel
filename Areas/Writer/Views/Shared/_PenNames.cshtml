@* _PenName.cshtml *@

@model List<Web_Novel.ViewModels.PenNameViewModel>

<div class="d-flex justify-content-between mb-3">
    <h4>นามปากกา</h4>

    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#penModal" onclick="openCreate()">
        + เพิ่มนามปากกา
    </button>
</div>

@if (Model == null || !Model.Any())
{
    <p>ยังไม่มีนามปากกา</p>
}
else
{
    <div class="list-group">
        @foreach (var p in Model)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">

                <div>
                    <strong>@p.PenName</strong>

                    
                    @if (p.IsDefault)
                    {
                        <span class="badge bg-success ms-2">หลัก</span>
                    }

                    <div class="text-muted small">@p.Bio</div>
                </div>

                <div>

                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#penModal"
                            onclick="openEdit(@p.PenNameId, '@p.PenName')">
                        แก้ไข
                    </button>

                    <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal"
                            onclick="setDeleteId(@p.PenNameId, '@p.PenName')">
                        ลบ
                    </button>
                </div>

            </div>
        }
    </div>
}

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">ยืนยันการลบ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p id="deleteText">คุณแน่ใจหรือไม่?</p>
            </div>

            <div class="modal-footer">
                <form method="post" asp-action="DeleteConfirmed" asp-area="Writer" asp-controller="PenName">
                    <input type="hidden" name="penNameId" id="deleteId" />
                    <button type="submit" class="btn btn-danger">ลบ</button>
                </form>

                <button class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
            </div>

        </div>
    </div>
</div>

<script>
    function setDeleteId(id, name) {
        document.getElementById("deleteId").value = id;
        document.getElementById("deleteText").innerText =
            "คุณต้องการลบนามปากกา \"" + name + "\" ใช่หรือไม่?";
    }
</script>